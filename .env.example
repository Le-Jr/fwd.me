# Banco: obrigatório na Vercel (disco efêmero). Em dev, sem elas, usa data/fwd.db.
# turso db show --url fwd  /  turso db tokens create fwd
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# As demais são opcionais. Sem elas, destinos sem link direto abrem a busca do serviço.

# Spotify Web API (Client Credentials): links diretos via ISRC
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# song.link / Odesli: links diretos pra todos os serviços (API pública foi fechada)
ODESLI_API_KEY=
ODESLI_COUNTRY=BR
